---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { waUmum } from '../lib/utils';
const path = Astro.url.pathname;
const aktif = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.nama} - Beranda`}>
      <span class="grid size-9 place-items-center bg-navy-900"><svg viewBox="0 0 64 64" class="size-9"><path d="M0 22h64M0 42h64M22 0v64M42 0v64" stroke="#e8650f" stroke-width="4"/><circle cx="22" cy="22" r="5" fill="#fff"/><circle cx="42" cy="42" r="5" fill="#fff"/></svg></span>
      <span class="text-[15px] font-extrabold leading-tight text-navy-900">Geotex<br class="hidden" /> Karya Agung</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigasi utama">
      {site.nav.map((n) => (
        <a href={n.href} aria-current={aktif(n.href) ? 'page' : undefined}
           class:list={['px-3 py-2 text-sm font-medium transition-colors hover:text-brand', aktif(n.href) ? 'text-brand' : 'text-navy-900']}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={waUmum} target="_blank" rel="noopener" class="btn btn-brand hidden sm:inline-flex"><Icon name="message" class="size-4" />Hubungi Kami</a>
      <button id="menu-btn" type="button" class="grid size-10 place-items-center border border-line text-navy-900 lg:hidden" aria-label="Buka menu" aria-expanded="false" aria-controls="menu-mobile">
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <nav id="menu-mobile" class="hidden border-t border-line bg-white lg:hidden" aria-label="Navigasi seluler">
    <div class="container-x flex flex-col py-2">
      {site.nav.map((n) => (
        <a href={n.href} class:list={['border-b border-line/60 py-3 text-sm font-semibold', aktif(n.href) ? 'text-brand' : 'text-navy-900']}>{n.label}</a>
      ))}
      <a href={waUmum} target="_blank" rel="noopener" class="btn btn-brand my-3"><Icon name="message" class="size-4" />Hubungi Kami</a>
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-mobile');
  btn?.addEventListener('click', () => {
    const buka = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(buka));
  });
</script>
