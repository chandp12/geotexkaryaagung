---
import Icon from './Icon.astro';
import BgImage from './BgImage.astro';
import { site } from '../data/site';
import { getProducts } from '../lib/content';
import { foto } from '../lib/images';
import { waUmum } from '../lib/utils';
const produk = await getProducts();
---
<footer class="relative overflow-hidden bg-navy-950 text-white/85">
  <BgImage src={foto('footer', 1, 44)} hint="src/assets/footer/01.jpg" eager={false} overlay="bg-linear-to-b from-navy-950/90 via-navy-950/85 to-navy-950/95" />
  <div class="container-x relative grid gap-10 py-16 md:grid-cols-4">
    <div>
      <p class="text-lg font-extrabold text-white">{site.nama}</p>
      <p class="mt-3 text-sm leading-relaxed">{site.bidang}. Berdiri sejak {site.tahun}.</p>
      <a href={waUmum} target="_blank" rel="noopener" class="btn btn-brand mt-5"><Icon name="message" class="size-4" />Chat WhatsApp</a>
    </div>
    <div>
      <p class="text-sm font-bold text-white">Navigasi</p>
      <ul class="mt-3 space-y-2 text-sm">
        {site.nav.map((n) => <li><a href={n.href} class="hover:text-white">{n.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-sm font-bold text-white">Produk</p>
      <ul class="mt-3 space-y-2 text-sm">
        {produk.map((p) => <li><a href={`/produk/${p.slug}/`} class="hover:text-white">{p.nama}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-sm font-bold text-white">Kontak</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li class="flex items-center gap-2"><Icon name="message" class="size-4 text-brand" />WhatsApp: {site.waTampil}</li>
        {site.email && <li>{site.email}</li>}
        {site.alamat && <li class="flex gap-2"><Icon name="pin" class="mt-0.5 size-4 shrink-0 text-brand" />{site.alamat}</li>}
        {site.mapsLink && <li><a href={site.mapsLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-white"><Icon name="pin" class="size-4 text-brand" />Lihat lokasi di Google Maps</a></li>}
      </ul>
    </div>
  </div>
  <div class="relative border-t border-white/15 py-5 text-center text-xs text-white/65">
    © {new Date().getFullYear()} {site.nama}. Hak cipta dilindungi.
  </div>
</footer>
