---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src?: ImageMetadata; alt: string; class?: string; widths?: number[]; sizes?: string; eager?: boolean; hint?: string }
const { src, alt, class: cls = '', widths = [480, 800, 1200], sizes = '(min-width:1024px) 50vw, 100vw', eager = false, hint } = Astro.props;
---
{src ? (
  <Image src={src} alt={alt} widths={widths} sizes={sizes} format="webp" quality={72} loading={eager ? 'eager' : 'lazy'} decoding="async" class={cls} />
) : (
  <div class:list={['lattice grid place-items-center bg-navy-800 text-white/60', cls]} role={alt ? 'img' : undefined} aria-label={alt || undefined}>
    {import.meta.env.DEV && hint ? <span class="p-2 text-center text-[11px] leading-tight">{hint}</span> : null}
  </div>
)}
