---
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';
interface Props { src?: ImageMetadata; hint?: string; overlay?: string; lattice?: boolean }
const { src, hint, overlay = 'bg-navy-950/70', lattice = true } = Astro.props;
---
<div class="absolute inset-0" aria-hidden="true">
  <Photo src={src} alt="" hint={hint} eager widths={[800, 1280, 1920]} sizes="100vw" class="size-full object-cover" />
  <div class:list={['absolute inset-0', overlay]}></div>
  {lattice && <div class="lattice absolute inset-0 opacity-70"></div>}
</div>
