---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { foto } from '../lib/images';
interface Props { judul?: string; teks?: string; href: string }
const { judul = 'Diskusikan kebutuhan proyek Anda', teks = 'Sebutkan jenis proyek dan produk yang Anda cari. Kami balas melalui WhatsApp.', href } = Astro.props;
---
<section class="bg-white py-14 md:py-20">
  <div class="container-x">
    <div class="grid overflow-hidden bg-navy-900 text-white md:grid-cols-[0.85fr_1.15fr]">
      <div class="relative hidden min-h-64 md:block">
        <Photo src={foto('cta', 1, 3)} alt="" hint="src/assets/cta/01.jpg" class="absolute inset-0 size-full object-cover" widths={[480, 800]} sizes="40vw" />
        <div class="absolute inset-y-0 right-0 w-1.5 bg-brand"></div>
      </div>
      <div class="lattice p-8 md:p-12">
        <h2 class="max-w-md text-2xl font-extrabold leading-tight md:text-3xl">{judul}</h2>
        <p class="mt-3 max-w-md text-white/80">{teks}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={href} target="_blank" rel="noopener" class="btn btn-brand"><Icon name="message" class="size-4" />Konsultasi via WhatsApp</a>
          <a href="/produk/" class="btn btn-outline">Lihat produk</a>
        </div>
      </div>
    </div>
  </div>
</section>
