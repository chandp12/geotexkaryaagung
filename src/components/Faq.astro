---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="divide-y divide-line border-y border-line">
  {items.map((f) => (
    <details class="group py-4">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-navy-900 [&::-webkit-details-marker]:hidden">
        {f.q}
        <Icon name="plus" class="size-5 shrink-0 text-brand transition-transform group-open:rotate-45" />
      </summary>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink/75">{f.a}</p>
    </details>
  ))}
</div>
