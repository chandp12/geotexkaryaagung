---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ProductPlaceholder from './ProductPlaceholder.astro';
import { productImages } from '../lib/images';
import { waProduk } from '../lib/utils';
import type { Produk } from '../types';
interface Props { p: Produk }
const { p } = Astro.props;
const foto = productImages(p.slug)[0];
---
<article class="product-card flex flex-col border border-line bg-white" data-nama={p.nama.toLowerCase()} data-info={`${p.singkat} ${p.keywordPendukung.join(' ')}`.toLowerCase()}>
  <a href={`/produk/${p.slug}/`} class="block aspect-[4/3] overflow-hidden bg-mist" tabindex="-1" aria-hidden="true">
    {foto
      ? <Image src={foto} alt={`${p.nama} Geotex Karya Agung`} width={640} height={480} format="webp" loading="lazy" class="size-full object-cover" />
      : <ProductPlaceholder nama={p.nama} icon={p.icon} />}
  </a>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-extrabold text-navy-900"><a href={`/produk/${p.slug}/`} class="hover:text-brand">{p.nama}</a></h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/75">{p.singkat}</p>
    <div class="mt-5 flex gap-2">
      <a href={`/produk/${p.slug}/`} class="btn btn-navy flex-1 !py-2.5">Lihat detail</a>
      <a href={waProduk(p.nama)} target="_blank" rel="noopener" class="btn btn-outline-dark !px-3 !py-2.5" aria-label={`Konsultasi ${p.nama} via WhatsApp`}><Icon name="message" class="size-4" /></a>
    </div>
  </div>
</article>
