---
import Base from '../layouts/Base.astro';
import { waUmum } from '../lib/utils';
---
<Base title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak tersedia." noindex>
  <section class="section">
    <div class="container-x max-w-xl text-center">
      <h1 class="text-4xl font-extrabold text-navy-900">Halaman tidak ditemukan</h1>
      <p class="mt-3 text-ink/75">Alamat yang Anda buka tidak ada atau sudah dipindahkan.</p>
      <div class="mt-6 flex justify-center gap-3"><a href="/" class="btn btn-navy">Ke beranda</a><a href="/produk/" class="btn btn-outline-dark">Lihat produk</a><a href={waUmum} target="_blank" rel="noopener" class="btn btn-brand">WhatsApp</a></div>
    </div>
  </section>
</Base>
