---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import BgImage from '../components/BgImage.astro';
import Gallery from '../components/Gallery.astro';
import Alur from '../components/Alur.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { aplikasi, alur, faq } from '../data/konten';
import { foto, fotoSet, hero } from '../lib/images';
import { waUmum, faqLd } from '../lib/utils';
const crumbs = [{ name: 'Proyek', href: '/proyek/' }];
const galeri = fotoSet('proyek', 12, 20);
const strip = [1, 2, 3].map((n) => foto('proyek', n, 20 + n - 1));
const f = faq.slice(4, 8);
---
<Base title="Proyek Geotextile dan Geosynthetic" description="Dokumentasi dan bidang aplikasi produk geotextile dan geosynthetic Geotex Karya Agung pada proyek jalan, lereng, drainase, dan kolam." crumbs={crumbs} jsonLd={[faqLd(f)]}>
  <!-- Hero: teks di kiri bawah, strip foto di kanan -->
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <BgImage src={hero(5)} hint="src/assets/hero/05.jpg" overlay="bg-linear-to-t from-navy-950/95 via-navy-950/60 to-navy-900/30" />
    <div class="container-x relative grid min-h-[460px] items-end gap-8 py-14 lg:grid-cols-[1.2fr_0.8fr] md:py-20">
      <div>
        <nav aria-label="Breadcrumb" class="mb-5 text-sm text-white/70"><a href="/" class="hover:text-white">Beranda</a> / <span aria-current="page" class="text-white">Proyek</span></nav>
        <h1 class="max-w-2xl text-4xl font-extrabold leading-tight md:text-6xl">Dokumentasi dan bidang proyek kami</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85">Produk geotextile dan geosynthetic pada jalan, lereng, drainase, kolam, dan sumber daya air.</p>
      </div>
      <ul class="hidden grid-cols-3 gap-2 lg:grid">
        {strip.map((s, i) => <li><Photo src={s} alt="Dokumentasi proyek Geotex Karya Agung" hint={`src/assets/proyek/0${i + 1}.jpg`} class="aspect-[3/4] size-full border border-white/30 object-cover" widths={[200, 320, 480]} sizes="150px" /></li>)}
      </ul>
    </div>
  </section>

  <!-- Bidang aplikasi -->
  <section class="section">
    <div class="container-x">
      <h2 class="text-3xl font-extrabold text-navy-900 md:text-4xl">Bidang pekerjaan</h2>
      <p class="mt-3 max-w-2xl text-ink/75">Produk kami dipakai pada berbagai jenis konstruksi. Berikut bidang aplikasi dan produk yang umum digunakan.</p>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {aplikasi.map((a, i) => (
          <li class="border border-line">
            <Photo src={foto('aplikasi', i + 1, 6 + i * 3)} alt={a.judul} hint={`src/assets/aplikasi/0${i + 1}.jpg`} class="aspect-[16/10] w-full object-cover" sizes="(min-width:1024px) 360px, 90vw" />
            <div class="p-5">
              <h3 class="flex items-center gap-2 font-extrabold text-navy-900"><Icon name={a.icon} class="size-5 text-brand" />{a.judul}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/75">{a.teks}</p>
              <p class="mt-3 flex flex-wrap gap-1.5">{a.produk.map((p) => <span class="bg-mist px-2 py-0.5 text-xs font-semibold text-navy-800">{p}</span>)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Galeri -->
  <section class="section bg-mist">
    <div class="container-x">
      <h2 class="flex items-center gap-3 text-3xl font-extrabold text-navy-900 md:text-4xl"><Icon name="camera" class="size-8 text-brand" />Galeri dokumentasi</h2>
      <p class="mt-3 max-w-2xl text-ink/75">Klik foto untuk memperbesar.</p>
      <div class="mt-8"><Gallery images={galeri} nama="Dokumentasi proyek" mosaic /></div>
    </div>
  </section>

  <!-- Statistik produk -->
  <section class="section lattice bg-navy-900 text-white">
    <div class="container-x">
      <h2 class="text-3xl font-extrabold md:text-4xl">Produk untuk proyek Anda</h2>
      <ul class="mt-10 grid gap-px bg-white/15 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ['hexagon', 'Perkuatan', 'Woven, Geogrid, GEOCELL untuk tanah dasar dan lereng.', '/produk/geogrid/'],
          ['droplets', 'Drainase', 'Drainase Cell, Geopipe, dan Geocomposite untuk mengalirkan air.', '/produk/geopipe/'],
          ['shield-check', 'Lapisan kedap', 'Geomembran untuk kolam, tambak, dan penampung.', '/produk/geomembran/'],
        ].map(([ic, jd, tx, href]) => (
          <li class="bg-navy-950 p-7">
            <Icon name={ic} class="size-8 text-brand" stroke={1.5} />
            <h3 class="mt-4 text-lg font-extrabold">{jd}</h3>
            <p class="mt-1 text-sm text-white/75">{tx}</p>
            <a href={href} class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand hover:underline">Lihat produk<Icon name="arrow" class="size-4" /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <h2 class="text-3xl font-extrabold text-navy-900 md:text-4xl">Mulai proyek bersama kami</h2>
      <div class="mt-10"><Alur langkah={alur} /></div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <h2 class="text-3xl font-extrabold text-navy-900">Pertanyaan umum</h2>
      <Faq items={f} />
    </div>
  </section>
  <Cta href={waUmum} judul="Punya proyek serupa?" teks="Ceritakan jenis proyek dan lokasinya, kami bantu arahkan produk yang sesuai." />
</Base>
