---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import BgImage from '../../components/BgImage.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { getArticles, getProducts } from '../../lib/content';
import { faq } from '../../data/konten';
import { hero } from '../../lib/images';
import { tanggalIndo, waUmum, faqLd } from '../../lib/utils';
const artikel = await getArticles();
const produk = await getProducts();
const [utama, ...lain] = artikel;
const crumbs = [{ name: 'Artikel', href: '/artikel/' }];
const f = faq.slice(0, 4);
---
<Base title="Artikel Geotextile dan Geosynthetic" description="Artikel dan panduan seputar geotextile, geosynthetic, perkuatan tanah, drainase, dan pengendalian erosi dari Geotex Karya Agung." crumbs={crumbs} jsonLd={[faqLd(f)]}>
  <!-- Hero: teks kiri, kartu artikel utama di kanan -->
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <BgImage src={hero(6)} hint="src/assets/hero/06.jpg" overlay="bg-linear-to-r from-navy-950/95 via-navy-900/85 to-navy-900/60" />
    <div class="container-x relative grid items-center gap-10 py-16 md:py-24 lg:grid-cols-[1fr_0.9fr]">
      <div>
        <nav aria-label="Breadcrumb" class="mb-5 text-sm text-white/70"><a href="/" class="hover:text-white">Beranda</a> / <span aria-current="page" class="text-white">Artikel</span></nav>
        <h1 class="text-4xl font-extrabold leading-tight md:text-6xl">Wawasan geotextile dan geosynthetic</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85">Panduan memilih material, memahami fungsi produk, dan solusi untuk kebutuhan tanah proyek Anda.</p>
      </div>
      {utama && (
        <a href={`/artikel/${utama.slug}/`} class="block bg-white text-ink">
          <Photo src={utama.gambar} alt={utama.judul} hint="src/assets/artikel/01.jpg" eager class="aspect-video w-full object-cover" sizes="(min-width:1024px) 480px, 90vw" />
          <div class="p-5">
            <p class="text-xs text-ink/60">Artikel terbaru · {tanggalIndo(utama.tanggal)}</p>
            <h2 class="mt-1 text-lg font-extrabold text-navy-900">{utama.judul}</h2>
            <p class="mt-1 text-sm text-ink/75">{utama.ringkasan}</p>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <h2 class="text-3xl font-extrabold text-navy-900 md:text-4xl">Semua artikel</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {artikel.map((a) => (
          <li class="flex flex-col border border-line">
            <a href={`/artikel/${a.slug}/`} class="block"><Photo src={a.gambar} alt={a.judul} hint={`src/assets/artikel/0${a.fotoNo}.jpg`} class="aspect-video w-full object-cover" sizes="(min-width:1024px) 360px, 90vw" /></a>
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs text-ink/60"><span class="font-semibold text-brand">{a.kategori}</span> · {tanggalIndo(a.tanggal)}</p>
              <h3 class="mt-2 font-extrabold text-navy-900"><a href={`/artikel/${a.slug}/`} class="hover:text-brand">{a.judul}</a></h3>
              <p class="mt-2 flex-1 text-sm text-ink/75">{a.ringkasan}</p>
              <a href={`/artikel/${a.slug}/`} class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand">Baca selengkapnya<Icon name="arrow" class="size-4" /></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section lattice bg-navy-900 text-white">
    <div class="container-x">
      <h2 class="text-3xl font-extrabold md:text-4xl">Pelajari produk kami</h2>
      <ul class="mt-8 grid grid-cols-2 gap-px bg-white/15 md:grid-cols-3 lg:grid-cols-5">
        {produk.map((p) => (
          <li class="bg-navy-950"><a href={`/produk/${p.slug}/`} class="flex items-center gap-3 p-4 text-sm font-bold hover:bg-brand"><Icon name={p.icon} class="size-5 shrink-0" />{p.nama}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <h2 class="text-3xl font-extrabold text-navy-900">Pertanyaan umum</h2>
      <Faq items={f} />
    </div>
  </section>
  <Cta href={waUmum} />
</Base>
